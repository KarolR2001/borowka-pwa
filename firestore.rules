rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isApprovedActiveProfile(profileData) {
      return profileData.active == true &&
        profileData.registrationStatus == 'APPROVED';
    }

    function hasApprovedActiveProfile(uid) {
      return hasProfile(uid) && isApprovedActiveProfile(profile(uid));
    }

    function hasRole(role) {
      return isSignedIn() &&
        hasApprovedActiveProfile(request.auth.uid) &&
        profile(request.auth.uid).role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isOperator() {
      return hasRole('OPERATOR');
    }

    function isUserRole(role) {
      return role == 'ADMIN' || role == 'OPERATOR' || role == 'PICKER';
    }

    function isInvitationStatus(status) {
      return status == 'PENDING' ||
        status == 'USED' ||
        status == 'CANCELLED' ||
        status == 'EXPIRED';
    }

    function isSeasonStatus(status) {
      return status == 'PLANNED' ||
        status == 'OPEN' ||
        status == 'CLOSED' ||
        status == 'ARCHIVED';
    }

    function isAuditAction(action) {
      return action == 'USER_ROLE_CHANGED' ||
        action == 'USER_WORKER_LINK_CHANGED' ||
        action == 'USER_BLOCKED' ||
        action == 'USER_REACTIVATED' ||
        action == 'REGISTRATION_INVITATION_CREATED' ||
        action == 'REGISTRATION_INVITATION_CANCELLED' ||
        action == 'REGISTRATION_INVITATION_EXPIRED' ||
        action == 'SEASON_CREATED' ||
        action == 'SEASON_OPENED' ||
        action == 'SEASON_CLOSED' ||
        action == 'SEASON_REOPENED' ||
        action == 'SEASON_ARCHIVED' ||
        action == 'SEASON_DEFAULT_CHANGED' ||
        action == 'SETTLEMENT_PLAN_CREATED' ||
        action == 'SETTLEMENT_PLAN_UPDATED' ||
        action == 'SETTLEMENT_PLAN_ARCHIVED' ||
        action == 'WORKER_CREATED' ||
        action == 'WORKER_ARCHIVED' ||
        action == 'WORKER_RATE_CHANGED';
    }

    function isAuditEntityType(entityType) {
      return entityType == 'USER_PROFILE' ||
        entityType == 'REGISTRATION_INVITATION' ||
        entityType == 'SEASON' ||
        entityType == 'SETTLEMENT_PLAN' ||
        entityType == 'WORKER';
    }

    function isSettlementCalculationBasis(calculationBasis) {
      return calculationBasis == 'WEIGHT' ||
        calculationBasis == 'QUANTITY';
    }

    function hasInvitedUserProfileFields(data) {
      return data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'role',
        'workerId',
        'active',
        'registrationStatus',
        'offlineConsent',
        'registrationInvitationId'
      ]) &&
        data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'workerId',
          'active',
          'registrationStatus',
          'offlineConsent',
          'registrationInvitationId'
        ]);
    }

    function hasValidInvitedUserProfileBase(data, userId) {
      return hasInvitedUserProfileFields(data) &&
        data.uid == userId &&
        data.uid is string &&
        data.email is string &&
        data.email.size() > 0 &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        isUserRole(data.role) &&
        (data.workerId == null || data.workerId is string) &&
        data.active == true &&
        data.registrationStatus == 'APPROVED' &&
        data.offlineConsent == false &&
        data.registrationInvitationId is string &&
        data.registrationInvitationId.size() > 0;
    }

    function hasPendingInvitationForProfile(data) {
      return exists(
        /databases/$(database)/documents/registrationInvitations/$(data.registrationInvitationId)
      ) &&
        get(
          /databases/$(database)/documents/registrationInvitations/$(data.registrationInvitationId)
        ).data.status == 'PENDING' &&
        get(
          /databases/$(database)/documents/registrationInvitations/$(data.registrationInvitationId)
        ).data.emailNormalized == data.email &&
        get(
          /databases/$(database)/documents/registrationInvitations/$(data.registrationInvitationId)
        ).data.displayName == data.displayName &&
        get(
          /databases/$(database)/documents/registrationInvitations/$(data.registrationInvitationId)
        ).data.targetRole == data.role &&
        get(
          /databases/$(database)/documents/registrationInvitations/$(data.registrationInvitationId)
        ).data.workerId == data.workerId;
    }

    function isValidInvitedUserProfileCreate(data, userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        request.auth.token.email is string &&
        data.email == request.auth.token.email &&
        hasValidInvitedUserProfileBase(data, userId) &&
        hasPendingInvitationForProfile(data);
    }

    function isOwnOfflineConsentUpdate(data, previous, userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        hasApprovedActiveProfile(userId) &&
        data.diff(previous).affectedKeys().hasOnly(['offlineConsent']) &&
        data.offlineConsent is bool;
    }

    function hasValidUserRoleWorkerPair(data) {
      return isUserRole(data.role) &&
        ((
          data.role == 'PICKER' &&
          data.workerId is string &&
          data.workerId.size() > 0
        ) || (
          data.role != 'PICKER' &&
          (data.workerId == null || data.workerId is string)
        ));
    }

    function isValidAdminRoleOrWorkerUpdate(data, previous, userId) {
      return isAdmin() &&
        request.auth.uid != userId &&
        previous.active == true &&
        previous.registrationStatus == 'APPROVED' &&
        data.role != previous.role &&
        data.diff(previous).affectedKeys().hasOnly(['role', 'workerId']) &&
        hasValidUserRoleWorkerPair(data);
    }

    function isValidAdminWorkerAccountLinkUserUpdate(data, previous, userId) {
      return isAdmin() &&
        request.auth.uid != userId &&
        previous.active == true &&
        previous.registrationStatus == 'APPROVED' &&
        data.diff(previous).affectedKeys().hasOnly(['workerId']) &&
        hasValidUserRoleWorkerPair(data);
    }

    function isValidAdminActivationUpdate(data, previous, userId) {
      return isAdmin() &&
        request.auth.uid != userId &&
        (
          (
            previous.active == true &&
            previous.registrationStatus == 'APPROVED' &&
            data.active == false &&
            data.registrationStatus == 'BLOCKED' &&
            data.diff(previous).affectedKeys().hasOnly([
              'active',
              'registrationStatus'
            ])
          ) || (
            previous.active == false &&
            previous.registrationStatus == 'BLOCKED' &&
            data.active == true &&
            data.registrationStatus == 'APPROVED' &&
            data.diff(previous).affectedKeys().hasOnly([
              'active',
              'registrationStatus',
              'role',
              'workerId'
            ]) &&
            hasValidUserRoleWorkerPair(data)
          )
        );
    }

    function hasInvitationFields(data) {
      return data.keys().hasOnly([
        'id',
        'emailNormalized',
        'displayName',
        'targetRole',
        'workerId',
        'status',
        'createdBy',
        'createdAt',
        'usedBy',
        'usedAt',
        'expiresAt'
      ]) &&
        data.keys().hasAll([
          'id',
          'emailNormalized',
          'displayName',
          'targetRole',
          'workerId',
          'status',
          'createdBy',
          'createdAt',
          'usedBy',
          'usedAt',
          'expiresAt'
        ]);
    }

    function hasValidInvitationWorker(data) {
      return (
        data.targetRole == 'PICKER' &&
        data.workerId is string &&
        data.workerId.size() > 0
      ) || (
        data.targetRole != 'PICKER' &&
        (data.workerId == null || data.workerId is string)
      );
    }

    function hasValidInvitationBase(data, invitationId) {
      return hasInvitationFields(data) &&
        data.id == invitationId &&
        data.id is string &&
        data.emailNormalized is string &&
        data.emailNormalized.size() > 0 &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        isUserRole(data.targetRole) &&
        isInvitationStatus(data.status) &&
        hasValidInvitationWorker(data) &&
        data.createdBy is string &&
        data.createdAt is timestamp &&
        (data.usedBy == null || data.usedBy is string) &&
        (data.usedAt == null || data.usedAt is timestamp) &&
        (data.expiresAt == null || data.expiresAt is timestamp);
    }

    function isValidInvitationCreate(data, invitationId) {
      return hasValidInvitationBase(data, invitationId) &&
        data.status == 'PENDING' &&
        data.createdBy == request.auth.uid &&
        data.usedBy == null &&
        data.usedAt == null;
    }

    function keepsInvitationAssignment(data, previous) {
      return data.id == previous.id &&
        data.emailNormalized == previous.emailNormalized &&
        data.displayName == previous.displayName &&
        data.targetRole == previous.targetRole &&
        data.workerId == previous.workerId &&
        data.createdBy == previous.createdBy &&
        data.createdAt == previous.createdAt &&
        data.usedBy == previous.usedBy &&
        data.usedAt == previous.usedAt &&
        data.expiresAt == previous.expiresAt;
    }

    function keepsInvitationClaimAssignment(data, previous) {
      return data.id == previous.id &&
        data.emailNormalized == previous.emailNormalized &&
        data.displayName == previous.displayName &&
        data.targetRole == previous.targetRole &&
        data.workerId == previous.workerId &&
        data.createdBy == previous.createdBy &&
        data.createdAt == previous.createdAt &&
        data.expiresAt == previous.expiresAt;
    }

    function isValidInvitationCancelOrExpire(data, previous, invitationId) {
      return hasValidInvitationBase(data, invitationId) &&
        previous.status == 'PENDING' &&
        (data.status == 'CANCELLED' || data.status == 'EXPIRED') &&
        keepsInvitationAssignment(data, previous);
    }

    function isOwnInvitation(data) {
      return isSignedIn() &&
        request.auth.token.email is string &&
        data.emailNormalized == request.auth.token.email;
    }

    function profileAfterMatchesInvitation(previous, invitationId) {
      return existsAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ) &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.uid == request.auth.uid &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.email == previous.emailNormalized &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.displayName == previous.displayName &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == previous.targetRole &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.workerId == previous.workerId &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.registrationStatus == 'APPROVED' &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.registrationInvitationId == invitationId;
    }

    function isValidInvitationUse(data, previous, invitationId) {
      return isOwnInvitation(previous) &&
        hasValidInvitationBase(data, invitationId) &&
        previous.status == 'PENDING' &&
        data.status == 'USED' &&
        data.usedBy == request.auth.uid &&
        data.usedAt is timestamp &&
        keepsInvitationClaimAssignment(data, previous) &&
        profileAfterMatchesInvitation(previous, invitationId);
    }

    function hasAuditEventFields(data) {
      return data.keys().hasOnly([
        'id',
        'actorUid',
        'actorRoleSnapshot',
        'action',
        'entityType',
        'entityId',
        'businessDate',
        'beforeSummary',
        'afterSummary',
        'reason',
        'createdAtDevice',
        'createdAtServer',
        'deviceId'
      ]) &&
        data.keys().hasAll([
          'id',
          'actorUid',
          'actorRoleSnapshot',
          'action',
          'entityType',
          'entityId',
          'businessDate',
          'beforeSummary',
          'afterSummary',
          'reason',
          'createdAtDevice',
          'createdAtServer',
          'deviceId'
        ]);
    }

    function hasValidAuditSummary(summary) {
      return summary == null || (
        summary is map &&
        summary.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'targetRole',
          'workerId',
          'active',
          'registrationStatus',
          'offlineConsent',
          'status',
          'invitationId',
          'seasonId',
          'planId',
          'name',
          'code',
          'currentPlanId',
          'calculationBasis',
          'startDate',
          'endDate',
          'isDefault',
          'unitLabelSingular',
          'unitLabelPlural',
          'unitSymbol',
          'quantityPrecision',
          'weightRequired',
          'allowBatchQuantity',
          'description',
          'rateVersionId',
          'currentRateVersionId',
          'rateGroszPerUnit',
          'validFrom',
          'validTo'
        ]) &&
        (
          !summary.keys().hasAny(['role']) ||
          summary.role == null ||
          isUserRole(summary.role)
        ) &&
        (
          !summary.keys().hasAny(['targetRole']) ||
          summary.targetRole == null ||
          isUserRole(summary.targetRole)
        ) &&
        (
          !summary.keys().hasAny(['workerId']) ||
          summary.workerId == null ||
          summary.workerId is string
        ) &&
        (
          !summary.keys().hasAny(['active']) ||
          summary.active == null ||
          summary.active is bool
        ) &&
        (
          !summary.keys().hasAny(['registrationStatus']) ||
          summary.registrationStatus == null ||
          summary.registrationStatus == 'APPROVED' ||
          summary.registrationStatus == 'REJECTED' ||
          summary.registrationStatus == 'BLOCKED'
        ) &&
        (
          !summary.keys().hasAny(['status']) ||
          summary.status == null ||
          isInvitationStatus(summary.status) ||
          isSeasonStatus(summary.status) ||
          summary.status == 'APPROVED' ||
          summary.status == 'REJECTED' ||
          summary.status == 'BLOCKED'
        ) &&
        (
          !summary.keys().hasAny(['calculationBasis']) ||
          summary.calculationBasis == null ||
          isSettlementCalculationBasis(summary.calculationBasis)
        ) &&
        (
          !summary.keys().hasAny(['isDefault']) ||
          summary.isDefault == null ||
          summary.isDefault is bool
        ) &&
        (
          !summary.keys().hasAny(['quantityPrecision']) ||
          summary.quantityPrecision == null ||
          summary.quantityPrecision is int
        ) &&
        (
          !summary.keys().hasAny(['rateGroszPerUnit']) ||
          summary.rateGroszPerUnit == null ||
          summary.rateGroszPerUnit is int
        ) &&
        (
          !summary.keys().hasAny(['validTo']) ||
          summary.validTo == null ||
          summary.validTo is string
        ) &&
        (
          !summary.keys().hasAny(['weightRequired']) ||
          summary.weightRequired == null ||
          summary.weightRequired is bool
        ) &&
        (
          !summary.keys().hasAny(['allowBatchQuantity']) ||
          summary.allowBatchQuantity == null ||
          summary.allowBatchQuantity is bool
        )
      );
    }

    function isValidAuditEventCreate(data, auditEventId) {
      return hasAuditEventFields(data) &&
        data.id == auditEventId &&
        data.id is string &&
        data.actorUid == request.auth.uid &&
        data.actorRoleSnapshot == profile(request.auth.uid).role &&
        isAuditAction(data.action) &&
        isAuditEntityType(data.entityType) &&
        data.entityId is string &&
        data.entityId.size() > 0 &&
        (data.businessDate == null || data.businessDate is string) &&
        hasValidAuditSummary(data.beforeSummary) &&
        hasValidAuditSummary(data.afterSummary) &&
        (data.reason == null || data.reason is string) &&
        data.createdAtDevice is timestamp &&
        data.createdAtServer == request.time &&
        data.deviceId is string &&
        data.deviceId.size() > 0;
    }

    function hasDeviceFields(data) {
      return data.keys().hasOnly([
        'id',
        'userUid',
        'deviceName',
        'platform',
        'trustedOfflineStorage',
        'firstSeenAt',
        'lastSeenAt',
        'lastSuccessfulSyncAt',
        'active'
      ]) &&
        data.keys().hasAll([
          'id',
          'userUid',
          'deviceName',
          'platform',
          'trustedOfflineStorage',
          'firstSeenAt',
          'lastSeenAt',
          'lastSuccessfulSyncAt',
          'active'
        ]);
    }

    function hasValidDeviceBase(data, deviceId) {
      return hasDeviceFields(data) &&
        data.id == deviceId &&
        data.id is string &&
        data.id.size() > 0 &&
        data.userUid is string &&
        data.userUid.size() > 0 &&
        data.deviceName is string &&
        data.deviceName.size() > 0 &&
        (data.platform == null || data.platform is string) &&
        data.trustedOfflineStorage is bool &&
        data.firstSeenAt is timestamp &&
        data.lastSeenAt is timestamp &&
        (data.lastSuccessfulSyncAt == null || data.lastSuccessfulSyncAt is timestamp) &&
        data.active is bool;
    }

    function hasSeasonFields(data) {
      return data.keys().hasOnly([
        'id',
        'name',
        'startDate',
        'endDate',
        'status',
        'isDefault',
        'createdAt',
        'createdBy',
        'closedAt',
        'closedBy',
        'reopenedAt'
      ]) &&
        data.keys().hasAll([
          'id',
          'name',
          'startDate',
          'endDate',
          'status',
          'isDefault',
          'createdAt',
          'createdBy',
          'closedAt',
          'closedBy',
          'reopenedAt'
        ]);
    }

    function hasValidSeasonBase(data, seasonId) {
      return hasSeasonFields(data) &&
        data.id == seasonId &&
        data.id is string &&
        data.id.size() > 0 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.startDate is string &&
        data.startDate.size() > 0 &&
        (data.endDate == null || data.endDate is string) &&
        (data.endDate == null || data.endDate >= data.startDate) &&
        isSeasonStatus(data.status) &&
        data.isDefault is bool &&
        data.createdAt is timestamp &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        (data.closedAt == null || data.closedAt is timestamp) &&
        (data.closedBy == null || data.closedBy is string) &&
        (data.reopenedAt == null || data.reopenedAt is timestamp);
    }

    function isValidSeasonCreate(data, seasonId) {
      return isAdmin() &&
        hasValidSeasonBase(data, seasonId) &&
        (data.status == 'PLANNED' || data.status == 'OPEN') &&
        data.createdAt == request.time &&
        data.createdBy == request.auth.uid &&
        data.closedAt == null &&
        data.closedBy == null &&
        data.reopenedAt == null;
    }

    function keepsSeasonIdentity(data, previous) {
      return data.id == previous.id &&
        data.name == previous.name &&
        data.startDate == previous.startDate &&
        data.endDate == previous.endDate &&
        data.createdAt == previous.createdAt &&
        data.createdBy == previous.createdBy;
    }

    function keepsSeasonCloseMetadata(data, previous) {
      return data.closedAt == previous.closedAt &&
        data.closedBy == previous.closedBy &&
        data.reopenedAt == previous.reopenedAt;
    }

    function isValidSeasonDefaultUpdate(data, previous, seasonId) {
      return isAdmin() &&
        hasValidSeasonBase(data, seasonId) &&
        keepsSeasonIdentity(data, previous) &&
        data.status == previous.status &&
        keepsSeasonCloseMetadata(data, previous) &&
        data.diff(previous).affectedKeys().hasOnly(['isDefault']) &&
        (
          data.isDefault == false ||
          data.status != 'ARCHIVED'
        );
    }

    function isValidSeasonStatusUpdate(data, previous, seasonId) {
      return isAdmin() &&
        hasValidSeasonBase(data, seasonId) &&
        keepsSeasonIdentity(data, previous) &&
        data.isDefault == previous.isDefault &&
        data.diff(previous).affectedKeys().hasOnly([
          'status',
          'closedAt',
          'closedBy',
          'reopenedAt'
        ]) &&
        (
          (
            previous.status == 'PLANNED' &&
            data.status == 'OPEN' &&
            keepsSeasonCloseMetadata(data, previous)
          ) || (
            previous.status == 'OPEN' &&
            data.status == 'CLOSED' &&
            data.closedAt == request.time &&
            data.closedBy == request.auth.uid &&
            data.reopenedAt == previous.reopenedAt
          ) || (
            previous.status == 'CLOSED' &&
            data.status == 'OPEN' &&
            data.closedAt == previous.closedAt &&
            data.closedBy == previous.closedBy &&
            data.reopenedAt == request.time
          ) || (
            (previous.status == 'PLANNED' || previous.status == 'CLOSED') &&
            data.status == 'ARCHIVED' &&
            previous.isDefault == false &&
            keepsSeasonCloseMetadata(data, previous)
          )
        );
    }

    function canReadActiveConfiguration(data) {
      return isAdmin() ||
        (
          isOperator() &&
          data.active == true
        );
    }

    function hasSettlementPlanFields(data) {
      return data.keys().hasOnly([
        'id',
        'name',
        'code',
        'calculationBasis',
        'unitLabelSingular',
        'unitLabelPlural',
        'unitSymbol',
        'quantityPrecision',
        'weightRequired',
        'allowBatchQuantity',
        'description',
        'active',
        'systemDefault',
        'createdAt',
        'createdBy',
        'archivedAt'
      ]) &&
        data.keys().hasAll([
          'id',
          'name',
          'code',
          'calculationBasis',
          'unitLabelSingular',
          'unitLabelPlural',
          'unitSymbol',
          'quantityPrecision',
          'weightRequired',
          'allowBatchQuantity',
          'description',
          'active',
          'systemDefault',
          'createdAt',
          'createdBy',
          'archivedAt'
        ]);
    }

    function hasValidSettlementPlanBase(data, planId) {
      return hasSettlementPlanFields(data) &&
        data.id == planId &&
        data.id is string &&
        data.id.matches('^plan-[a-z0-9-]{2,50}$') &&
        data.name is string &&
        data.name.size() > 0 &&
        data.code is string &&
        data.code.matches('^[A-Z0-9_]{2,40}$') &&
        isSettlementCalculationBasis(data.calculationBasis) &&
        data.unitLabelSingular is string &&
        data.unitLabelSingular.size() > 0 &&
        data.unitLabelPlural is string &&
        data.unitLabelPlural.size() > 0 &&
        data.unitSymbol is string &&
        data.unitSymbol.size() > 0 &&
        data.quantityPrecision is int &&
        data.quantityPrecision >= 0 &&
        data.quantityPrecision <= 3 &&
        data.weightRequired is bool &&
        data.allowBatchQuantity is bool &&
        (data.description == null || data.description is string) &&
        data.active is bool &&
        data.systemDefault is bool &&
        data.createdAt is timestamp &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        (data.archivedAt == null || data.archivedAt is timestamp) &&
        (
          data.calculationBasis != 'WEIGHT' ||
          data.weightRequired == true
        );
    }

    function isValidSettlementPlanCreate(data, planId) {
      return isAdmin() &&
        hasValidSettlementPlanBase(data, planId) &&
        data.active == true &&
        data.systemDefault == false &&
        data.createdAt == request.time &&
        data.createdBy == request.auth.uid &&
        data.archivedAt == null;
    }

    function keepsSettlementPlanLockedFields(data, previous, planId) {
      return data.id == planId &&
        data.id == previous.id &&
        data.code == previous.code &&
        data.calculationBasis == previous.calculationBasis &&
        data.quantityPrecision == previous.quantityPrecision &&
        data.weightRequired == previous.weightRequired &&
        data.allowBatchQuantity == previous.allowBatchQuantity &&
        data.systemDefault == previous.systemDefault &&
        data.createdAt == previous.createdAt &&
        data.createdBy == previous.createdBy;
    }

    function isValidSettlementPlanPresentationUpdate(data, previous, planId) {
      return isAdmin() &&
        hasValidSettlementPlanBase(data, planId) &&
        keepsSettlementPlanLockedFields(data, previous, planId) &&
        data.active == previous.active &&
        data.archivedAt == previous.archivedAt &&
        data.diff(previous).affectedKeys().hasOnly([
          'name',
          'unitLabelSingular',
          'unitLabelPlural',
          'unitSymbol',
          'description'
        ]);
    }

    function isValidSettlementPlanArchiveUpdate(data, previous, planId) {
      return isAdmin() &&
        hasValidSettlementPlanBase(data, planId) &&
        keepsSettlementPlanLockedFields(data, previous, planId) &&
        previous.active == true &&
        previous.archivedAt == null &&
        data.active == false &&
        data.archivedAt == request.time &&
        data.diff(previous).affectedKeys().hasOnly([
          'active',
          'archivedAt'
        ]);
    }

    function isBusinessDate(value) {
      return value is string &&
        value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function activeSettlementPlanExists(planId) {
      return planId is string &&
        exists(/databases/$(database)/documents/settlementPlans/$(planId)) &&
        get(/databases/$(database)/documents/settlementPlans/$(planId)).data.active == true;
    }

    function workerRateVersionPath(rateVersionId) {
      return /databases/$(database)/documents/workerRateVersions/$(rateVersionId);
    }

    function workerPath(workerId) {
      return /databases/$(database)/documents/workers/$(workerId);
    }

    function hasWorkerFields(data) {
      return data.keys().hasOnly([
        'id',
        'displayName',
        'normalizedName',
        'active',
        'currentPlanId',
        'currentRateVersionId',
        'linkedUserUid',
        'phone',
        'emailContact',
        'notes',
        'createdAt',
        'createdBy',
        'updatedAt',
        'archivedAt',
        'legacyName'
      ]) &&
        data.keys().hasAll([
          'id',
          'displayName',
          'normalizedName',
          'active',
          'currentPlanId',
          'currentRateVersionId',
          'linkedUserUid',
          'phone',
          'emailContact',
          'notes',
          'createdAt',
          'createdBy',
          'updatedAt',
          'archivedAt',
          'legacyName'
        ]);
    }

    function hasValidWorkerBase(data, workerId) {
      return hasWorkerFields(data) &&
        data.id == workerId &&
        data.id is string &&
        data.id.matches('^worker-[A-Za-z0-9-]{8,90}$') &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.normalizedName is string &&
        data.normalizedName.size() > 0 &&
        data.active is bool &&
        data.currentPlanId is string &&
        data.currentPlanId.size() > 0 &&
        data.currentRateVersionId is string &&
        data.currentRateVersionId.size() > 0 &&
        (data.linkedUserUid == null || data.linkedUserUid is string) &&
        (data.phone == null || data.phone is string) &&
        (data.emailContact == null || data.emailContact is string) &&
        (data.notes == null || data.notes is string) &&
        data.createdAt is timestamp &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.updatedAt is timestamp &&
        (data.archivedAt == null || data.archivedAt is timestamp) &&
        (data.legacyName == null || data.legacyName is string);
    }

    function isValidWorkerCreate(data, workerId) {
      return isAdmin() &&
        hasValidWorkerBase(data, workerId) &&
        data.active == true &&
        activeSettlementPlanExists(data.currentPlanId) &&
        data.linkedUserUid == null &&
        data.createdAt == request.time &&
        data.createdBy == request.auth.uid &&
        data.updatedAt == request.time &&
        data.archivedAt == null &&
        data.legacyName == null &&
        existsAfter(workerRateVersionPath(data.currentRateVersionId)) &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.workerId == workerId &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.planId == data.currentPlanId &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.active == true;
    }

    function hasWorkerRateVersionFields(data) {
      return data.keys().hasOnly([
        'id',
        'workerId',
        'planId',
        'rateGroszPerUnit',
        'validFrom',
        'validTo',
        'active',
        'note',
        'createdAt',
        'createdBy',
        'supersedesRateId'
      ]) &&
        data.keys().hasAll([
          'id',
          'workerId',
          'planId',
          'rateGroszPerUnit',
          'validFrom',
          'validTo',
          'active',
          'note',
          'createdAt',
          'createdBy',
          'supersedesRateId'
        ]);
    }

    function hasValidWorkerRateVersionBase(data, rateVersionId) {
      return hasWorkerRateVersionFields(data) &&
        data.id == rateVersionId &&
        data.id is string &&
        data.id.matches('^rate-worker-[A-Za-z0-9-]{8,90}-\\d{4}-\\d{2}-\\d{2}$') &&
        data.workerId is string &&
        data.workerId.size() > 0 &&
        data.planId is string &&
        data.planId.size() > 0 &&
        data.rateGroszPerUnit is int &&
        data.rateGroszPerUnit > 0 &&
        isBusinessDate(data.validFrom) &&
        (data.validTo == null || isBusinessDate(data.validTo)) &&
        data.active is bool &&
        (data.note == null || data.note is string) &&
        data.createdAt is timestamp &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        (data.supersedesRateId == null || data.supersedesRateId is string);
    }

    function isValidInitialWorkerRateVersionCreate(data, rateVersionId) {
      return isAdmin() &&
        hasValidWorkerRateVersionBase(data, rateVersionId) &&
        data.active == true &&
        data.validTo == null &&
        data.supersedesRateId == null &&
        activeSettlementPlanExists(data.planId) &&
        data.createdAt == request.time &&
        data.createdBy == request.auth.uid &&
        existsAfter(workerPath(data.workerId)) &&
        getAfter(workerPath(data.workerId)).data.currentRateVersionId == rateVersionId &&
        getAfter(workerPath(data.workerId)).data.currentPlanId == data.planId &&
        getAfter(workerPath(data.workerId)).data.active == true;
    }

    function keepsWorkerLockedForRateChange(data, previous, workerId) {
      return data.id == workerId &&
        data.id == previous.id &&
        data.displayName == previous.displayName &&
        data.normalizedName == previous.normalizedName &&
        data.active == previous.active &&
        data.linkedUserUid == previous.linkedUserUid &&
        data.phone == previous.phone &&
        data.emailContact == previous.emailContact &&
        data.notes == previous.notes &&
        data.createdAt == previous.createdAt &&
        data.createdBy == previous.createdBy &&
        data.archivedAt == previous.archivedAt &&
        data.legacyName == previous.legacyName;
    }

    function isWorkerCurrentRateWrite(data, previous) {
      return data.diff(previous).affectedKeys().hasOnly([
        'currentPlanId',
        'currentRateVersionId',
        'updatedAt'
      ]);
    }

    function isValidWorkerCurrentRateUpdate(data, previous, workerId) {
      return isAdmin() &&
        hasValidWorkerBase(data, workerId) &&
        previous.active == true &&
        previous.archivedAt == null &&
        keepsWorkerLockedForRateChange(data, previous, workerId) &&
        isWorkerCurrentRateWrite(data, previous) &&
        data.currentRateVersionId != previous.currentRateVersionId &&
        data.updatedAt == request.time &&
        existsAfter(workerRateVersionPath(data.currentRateVersionId)) &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.workerId == workerId &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.planId == data.currentPlanId &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.active == true &&
        getAfter(workerRateVersionPath(data.currentRateVersionId)).data.supersedesRateId == previous.currentRateVersionId;
    }

    function keepsWorkerLockedForAccountLink(data, previous, workerId) {
      return data.id == workerId &&
        data.id == previous.id &&
        data.displayName == previous.displayName &&
        data.normalizedName == previous.normalizedName &&
        data.active == previous.active &&
        data.currentPlanId == previous.currentPlanId &&
        data.currentRateVersionId == previous.currentRateVersionId &&
        data.phone == previous.phone &&
        data.emailContact == previous.emailContact &&
        data.notes == previous.notes &&
        data.createdAt == previous.createdAt &&
        data.createdBy == previous.createdBy &&
        data.archivedAt == previous.archivedAt &&
        data.legacyName == previous.legacyName;
    }

    function isWorkerAccountLinkWrite(data, previous) {
      return data.diff(previous).affectedKeys().hasOnly([
        'linkedUserUid',
        'updatedAt'
      ]);
    }

    function isValidWorkerAccountLinkUpdate(data, previous, workerId) {
      return isAdmin() &&
        hasValidWorkerBase(data, workerId) &&
        previous.active == true &&
        keepsWorkerLockedForAccountLink(data, previous, workerId) &&
        isWorkerAccountLinkWrite(data, previous) &&
        data.linkedUserUid != previous.linkedUserUid &&
        data.updatedAt == request.time &&
        (
          previous.linkedUserUid == null ||
          previous.linkedUserUid == data.linkedUserUid ||
          data.linkedUserUid == null ||
          data.linkedUserUid is string
        );
    }

    function keepsWorkerLockedForArchive(data, previous, workerId) {
      return data.id == workerId &&
        data.id == previous.id &&
        data.displayName == previous.displayName &&
        data.normalizedName == previous.normalizedName &&
        data.currentPlanId == previous.currentPlanId &&
        data.currentRateVersionId == previous.currentRateVersionId &&
        data.linkedUserUid == previous.linkedUserUid &&
        data.phone == previous.phone &&
        data.emailContact == previous.emailContact &&
        data.notes == previous.notes &&
        data.createdAt == previous.createdAt &&
        data.createdBy == previous.createdBy &&
        data.legacyName == previous.legacyName;
    }

    function isWorkerArchiveWrite(data, previous) {
      return data.diff(previous).affectedKeys().hasOnly([
        'active',
        'updatedAt',
        'archivedAt'
      ]);
    }

    function isValidWorkerArchiveUpdate(data, previous, workerId) {
      return isAdmin() &&
        hasValidWorkerBase(data, workerId) &&
        keepsWorkerLockedForArchive(data, previous, workerId) &&
        previous.active == true &&
        previous.archivedAt == null &&
        data.active == false &&
        data.updatedAt == request.time &&
        data.archivedAt == request.time &&
        isWorkerArchiveWrite(data, previous);
    }

    function isValidSubsequentWorkerRateVersionCreate(data, rateVersionId) {
      return isAdmin() &&
        hasValidWorkerRateVersionBase(data, rateVersionId) &&
        data.active == true &&
        data.validTo == null &&
        data.supersedesRateId is string &&
        activeSettlementPlanExists(data.planId) &&
        data.createdAt == request.time &&
        data.createdBy == request.auth.uid &&
        exists(workerPath(data.workerId)) &&
        get(workerPath(data.workerId)).data.active == true &&
        get(workerPath(data.workerId)).data.currentRateVersionId == data.supersedesRateId &&
        existsAfter(workerPath(data.workerId)) &&
        getAfter(workerPath(data.workerId)).data.currentRateVersionId == rateVersionId &&
        getAfter(workerPath(data.workerId)).data.currentPlanId == data.planId &&
        getAfter(workerPath(data.workerId)).data.active == true &&
        existsAfter(workerRateVersionPath(data.supersedesRateId)) &&
        getAfter(workerRateVersionPath(data.supersedesRateId)).data.active == false &&
        getAfter(workerRateVersionPath(data.supersedesRateId)).data.validTo is string &&
        getAfter(workerRateVersionPath(data.supersedesRateId)).data.validTo < data.validFrom;
    }

    function keepsRateVersionLockedForClose(data, previous, rateVersionId) {
      return data.id == rateVersionId &&
        data.id == previous.id &&
        data.workerId == previous.workerId &&
        data.planId == previous.planId &&
        data.rateGroszPerUnit == previous.rateGroszPerUnit &&
        data.validFrom == previous.validFrom &&
        data.note == previous.note &&
        data.createdAt == previous.createdAt &&
        data.createdBy == previous.createdBy &&
        data.supersedesRateId == previous.supersedesRateId;
    }

    function isValidWorkerRateVersionCloseUpdate(data, previous, rateVersionId) {
      return isAdmin() &&
        hasValidWorkerRateVersionBase(data, rateVersionId) &&
        keepsRateVersionLockedForClose(data, previous, rateVersionId) &&
        previous.active == true &&
        previous.validTo == null &&
        data.active == false &&
        isBusinessDate(data.validTo) &&
        data.validTo >= data.validFrom &&
        data.diff(previous).affectedKeys().hasOnly(['active', 'validTo']) &&
        existsAfter(workerPath(data.workerId)) &&
        getAfter(workerPath(data.workerId)).data.currentRateVersionId != rateVersionId &&
        existsAfter(
          workerRateVersionPath(
            getAfter(workerPath(data.workerId)).data.currentRateVersionId
          )
        ) &&
        getAfter(
          workerRateVersionPath(
            getAfter(workerPath(data.workerId)).data.currentRateVersionId
          )
        ).data.supersedesRateId == rateVersionId &&
        data.validTo < getAfter(
          workerRateVersionPath(
            getAfter(workerPath(data.workerId)).data.currentRateVersionId
          )
        ).data.validFrom;
    }

    function isOwnExistingDevice(deviceId) {
      return exists(/databases/$(database)/documents/devices/$(deviceId)) &&
        resource.data.userUid == request.auth.uid;
    }

    function isValidOwnDeviceCreate(data, deviceId) {
      return isSignedIn() &&
        hasApprovedActiveProfile(request.auth.uid) &&
        data.userUid == request.auth.uid &&
        hasValidDeviceBase(data, deviceId) &&
        data.active == true &&
        data.firstSeenAt == request.time &&
        data.lastSeenAt == request.time &&
        data.lastSuccessfulSyncAt == null;
    }

    function keepsDeviceIdentity(data, previous) {
      return data.id == previous.id &&
        data.userUid == previous.userUid &&
        data.firstSeenAt == previous.firstSeenAt &&
        data.active == previous.active;
    }

    function isValidOwnDeviceUpdate(data, previous, deviceId) {
      return isSignedIn() &&
        hasApprovedActiveProfile(request.auth.uid) &&
        previous.userUid == request.auth.uid &&
        previous.active == true &&
        hasValidDeviceBase(data, deviceId) &&
        keepsDeviceIdentity(data, previous) &&
        data.diff(previous).affectedKeys().hasOnly([
          'deviceName',
          'platform',
          'trustedOfflineStorage',
          'lastSeenAt',
          'lastSuccessfulSyncAt'
        ]) &&
        data.lastSeenAt == request.time;
    }

    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isValidInvitedUserProfileCreate(
        request.resource.data,
        userId
      );
      allow update: if isOwnOfflineConsentUpdate(
        request.resource.data,
        resource.data,
        userId
      ) || isValidAdminWorkerAccountLinkUserUpdate(
        request.resource.data,
        resource.data,
        userId
      ) || isValidAdminRoleOrWorkerUpdate(
        request.resource.data,
        resource.data,
        userId
      ) || isValidAdminActivationUpdate(
        request.resource.data,
        resource.data,
        userId
      );
      allow delete: if false;
    }

    match /registrationInvitations/{invitationId} {
      allow get: if isAdmin() || isOwnInvitation(resource.data);
      allow list: if isAdmin() || isOwnInvitation(resource.data);
      allow create: if isAdmin() &&
        isValidInvitationCreate(request.resource.data, invitationId);
      allow update: if (
        isAdmin() &&
          isValidInvitationCancelOrExpire(
            request.resource.data,
            resource.data,
            invitationId
          )
      ) || isValidInvitationUse(
        request.resource.data,
        resource.data,
        invitationId
      );
      allow delete: if false;
    }

    match /auditEvents/{auditEventId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
        isValidAuditEventCreate(request.resource.data, auditEventId);
      allow update, delete: if false;
    }

    match /devices/{deviceId} {
      allow get: if isAdmin() ||
        (
          isSignedIn() &&
          hasApprovedActiveProfile(request.auth.uid) &&
          (
            !exists(/databases/$(database)/documents/devices/$(deviceId)) ||
            isOwnExistingDevice(deviceId)
          )
        );
      allow list: if isAdmin();
      allow create: if isValidOwnDeviceCreate(request.resource.data, deviceId);
      allow update: if isValidOwnDeviceUpdate(
        request.resource.data,
        resource.data,
        deviceId
      );
      allow delete: if false;
    }

    match /seasons/{seasonId} {
      allow get, list: if isSignedIn() &&
        hasApprovedActiveProfile(request.auth.uid);
      allow create: if isValidSeasonCreate(request.resource.data, seasonId);
      allow update: if isValidSeasonDefaultUpdate(
        request.resource.data,
        resource.data,
        seasonId
      ) || isValidSeasonStatusUpdate(
        request.resource.data,
        resource.data,
        seasonId
      );
      allow delete: if false;
    }

    match /settlementPlans/{planId} {
      allow get, list: if canReadActiveConfiguration(resource.data);
      allow create: if isValidSettlementPlanCreate(request.resource.data, planId);
      allow update: if isValidSettlementPlanPresentationUpdate(
        request.resource.data,
        resource.data,
        planId
      ) || isValidSettlementPlanArchiveUpdate(
        request.resource.data,
        resource.data,
        planId
      );
      allow delete: if false;
    }

    match /workers/{workerId} {
      allow get, list: if canReadActiveConfiguration(resource.data);
      allow create: if isValidWorkerCreate(request.resource.data, workerId);
      allow update: if (
        isWorkerArchiveWrite(request.resource.data, resource.data) &&
          isValidWorkerArchiveUpdate(request.resource.data, resource.data, workerId)
      ) || (
        isWorkerAccountLinkWrite(request.resource.data, resource.data) &&
          isValidWorkerAccountLinkUpdate(request.resource.data, resource.data, workerId)
      ) || (
        isWorkerCurrentRateWrite(request.resource.data, resource.data) &&
          isValidWorkerCurrentRateUpdate(request.resource.data, resource.data, workerId)
      );
      allow delete: if false;
    }

    match /workerRateVersions/{rateVersionId} {
      allow get, list: if canReadActiveConfiguration(resource.data);
      allow create: if isValidInitialWorkerRateVersionCreate(
        request.resource.data,
        rateVersionId
      ) || isValidSubsequentWorkerRateVersionCreate(
        request.resource.data,
        rateVersionId
      );
      allow update: if isValidWorkerRateVersionCloseUpdate(
        request.resource.data,
        resource.data,
        rateVersionId
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
